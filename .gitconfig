# File not recognized by default. Must be linked with git's `include.path`.
# This happens via the flake dev shell.

# Order matters and is the order below: fmt-check rewrites the worktree (treefmt
# always writes; --fail-on-change only adds the exit code), the generator checks
# regenerate from the formatted sources and diff against the committed output
# (ffigen's golden and apigen's dispatch files; seconds each, and minimal-ci
# otherwise is the first to see a stale golden), and the ratchet reads both
# ledgers. `just refresh` regenerates all of it in that same order.
# artifact-guard leads: it reads the index rather than the worktree and costs
# milliseconds, and there is no point formatting or measuring a commit that has
# a core dump in it.
[hook "artifact-guard"]
  event = pre-commit
  command = just artifact-guard

[hook "fmt-check"]
  event = pre-commit
  command = just fmt-check

[hook "ffigen"]
  event = pre-commit
  command = just ffigen --check

[hook "apigen"]
  event = pre-commit
  command = just apigen --check

[hook "abi-ledger"]
  event = pre-commit
  command = just abi-ledger --check

[hook "visibility-ledger"]
  event = pre-commit
  command = just visibility-ledger --check

[hook "ratchet"]
  event = pre-commit
  command = just ratchet --check
