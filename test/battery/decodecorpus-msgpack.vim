" msgpack decode hand-differential: feed msgpackparse() a corpus of raw byte
" strings covering the type matrix, print string() of the result or the error.
let s:cases = []
func! Add(name, bytes)
  call add(s:cases, [a:name, a:bytes])
endfunc
" helper: build a Blob from a list of byte values
func! B(l)
  let b = 0z
  for x in a:l | let b += printf('0z%02X', x)->eval() | endfor
  return b
endfunc
call Add('nil',            B([0xc0]))
call Add('false',          B([0xc2]))
call Add('true',           B([0xc3]))
call Add('fixint0',        B([0x00]))
call Add('fixint127',      B([0x7f]))
call Add('negfixint',      B([0xff]))
call Add('uint8',          B([0xcc, 0xff]))
call Add('uint16',         B([0xcd, 0xff, 0xff]))
call Add('uint32',         B([0xce, 0xff, 0xff, 0xff, 0xff]))
call Add('uint64max',      B([0xcf, 0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff]))
call Add('uint64_hi',      B([0xcf, 0x80,0x00,0x00,0x00,0x00,0x00,0x00,0x00]))
call Add('uint64_maxvar',  B([0xcf, 0x7f,0xff,0xff,0xff,0xff,0xff,0xff,0xff]))
call Add('int8',           B([0xd0, 0x80]))
call Add('int16',          B([0xd1, 0x80, 0x00]))
call Add('int32',          B([0xd2, 0x80,0,0,0]))
call Add('int64min',       B([0xd3, 0x80,0,0,0,0,0,0,0]))
call Add('float32',        B([0xca, 0x3f,0x80,0x00,0x00]))
call Add('float64',        B([0xcb, 0x3f,0xf0,0,0,0,0,0,0]))
call Add('float_nan',      B([0xcb, 0x7f,0xf8,0,0,0,0,0,0]))
call Add('float_inf',      B([0xcb, 0x7f,0xf0,0,0,0,0,0,0]))
call Add('fixstr_empty',   B([0xa0]))
call Add('fixstr_abc',     B([0xa3, 0x61,0x62,0x63]))
call Add('str_with_nul',   B([0xa3, 0x61,0x00,0x63]))
call Add('str_invalid_u8', B([0xa2, 0xff,0xfe]))
call Add('str8',           B([0xd9, 0x02, 0x68,0x69]))
call Add('str16',          B([0xda, 0x00,0x02, 0x68,0x69]))
call Add('str32',          B([0xdb, 0x00,0x00,0x00,0x02, 0x68,0x69]))
call Add('bin8',           B([0xc4, 0x02, 0x00,0x01]))
call Add('bin16',          B([0xc5, 0x00,0x02, 0x00,0x01]))
call Add('bin32',          B([0xc6, 0x00,0x00,0x00,0x02, 0x00,0x01]))
call Add('fixext1',        B([0xd4, 0x05, 0x41]))
call Add('fixext2',        B([0xd5, 0x05, 0x41,0x42]))
call Add('fixext4',        B([0xd6, 0x7f, 0x41,0x42,0x43,0x44]))
call Add('fixext8',        B([0xd7, 0x01, 1,2,3,4,5,6,7,8]))
call Add('fixext16',       B([0xd8, 0x02] + range(16)))
call Add('ext8',           B([0xc7, 0x03, 0x09, 0x41,0x42,0x43]))
call Add('ext8_zero',      B([0xc7, 0x00, 0x09]))
call Add('ext16',          B([0xc8, 0x00,0x01, 0x09, 0x41]))
call Add('ext32',          B([0xc9, 0x00,0x00,0x00,0x01, 0x09, 0x41]))
call Add('ext_negtype',    B([0xd4, 0xff, 0x41]))
call Add('fixarray0',      B([0x90]))
call Add('fixarray3',      B([0x93, 0x01, 0x02, 0x03]))
call Add('array16',        B([0xdc, 0x00,0x02, 0x01, 0x02]))
call Add('array32',        B([0xdd, 0x00,0x00,0x00,0x02, 0x01, 0x02]))
call Add('nested_array',   B([0x91, 0x91, 0x91, 0x01]))
call Add('fixmap0',        B([0x80]))
call Add('fixmap_str',     B([0x82, 0xa1,0x61, 0x01, 0xa1,0x62, 0x02]))
call Add('map_dupkey',     B([0x82, 0xa1,0x61, 0x01, 0xa1,0x61, 0x02]))
call Add('map_emptykey',   B([0x81, 0xa0, 0x01]))
call Add('map_intkey',     B([0x81, 0x01, 0x02]))
call Add('map_nulkey',     B([0x81, 0xa2,0x61,0x00, 0x01]))
call Add('map_binkey',     B([0x81, 0xc4,0x01,0x61, 0x01]))
call Add('map16',          B([0xde, 0x00,0x01, 0xa1,0x61, 0x01]))
call Add('map32',          B([0xdf, 0x00,0x00,0x00,0x01, 0xa1,0x61, 0x01]))
call Add('map_nested',     B([0x81, 0xa1,0x61, 0x81, 0xa1,0x62, 0x01]))
call Add('map_arrval',     B([0x81, 0xa1,0x61, 0x92, 0x01, 0x02]))
call Add('two_objects',    B([0x01, 0x02]))
call Add('trunc_str',      B([0xa3, 0x61]))
call Add('trunc_array',    B([0x93, 0x01]))
call Add('trunc_map',      B([0x82, 0xa1,0x61, 0x01]))
call Add('trunc_uint',     B([0xcf, 0x00]))
call Add('reserved_c1',    B([0xc1]))
call Add('deep33',         B(repeat([0x91], 33) + [0x01]))
call Add('deep31',         B(repeat([0x91], 31) + [0x01]))
call Add('empty',          0z)
for [name, bytes] in s:cases
  let out = ''
  try
    let out = string(msgpackparse(bytes))
  catch
    let out = 'THROW ' . v:exception
  endtry
  echo name . "\t" . out
endfor
" and the round trip via msgpackdump
for [name, bytes] in s:cases
  let out = ''
  try
    let out = string(msgpackdump(msgpackparse(bytes), 'B'))
  catch
    let out = 'THROW ' . v:exception
  endtry
  echo 'rt:' . name . "\t" . out
endfor
